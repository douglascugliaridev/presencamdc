# Banco de dados (Postgres + PostGIS)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presencamdc?schema=public

# JWT - gerar com: openssl rand -base64 32
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Porta da API
PORT=3333

# CORS do painel web (separar por vírgula se houver múltiplos)
WEB_ORIGIN=http://localhost:3000